{
  "name": "posekit",
  "version": "0.1.0",
  "description": "Procedural 2D figure animation for exercise demonstration. Generates poses from joint angles at runtime, so range of motion, tempo and load are parameters rather than pre-rendered frames.",
  "keywords": [
    "exercise",
    "animation",
    "svg",
    "procedural",
    "inverse-kinematics",
    "fitness",
    "rehabilitation",
    "range-of-motion"
  ],
  "license": "MIT",
  "author": "Daniel Deladzikunu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfourmarvel/posekit.git"
  },
  "homepage": "https://github.com/dfourmarvel/posekit#readme",
  "bugs": {
    "url": "https://github.com/dfourmarvel/posekit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./exercises": {
      "types": "./dist/exercises/index.d.ts",
      "import": "./dist/exercises/index.js",
      "require": "./dist/exercises/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^20.17.12",
    "@types/react": "^19.0.7",
    "eslint": "^9.18.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
